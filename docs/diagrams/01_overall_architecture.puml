@startuml
!include theme.iuml
title Option Desk - Current runtime and package boundaries

actor "Person / local agent" as user
component "Local skills\n6 skills in shell/skills" as skills
component "Local MCP\noptiondesk-mcp, stdio\n12 typed tools" as mcp
component "CLI\noptiondesk commands" as cli
component "Optional agent package\nLangChain bindings\nbounded LangGraph workflow" as agent
package "Shell: input, output and presentation" {
 component "Snapshot import\nCSV / JSON + rights\nsource + timestamp" as imp
 component "Provider registry\ncapability + access checks" as reg
 component "engine_bridge\nsole shell-to-engine import" as bridge #C6E9C6
 component "Schema validation\n8 JSON schemas" as valid
 component "Artifact writer\narchive + atomic replacement" as writer
 component "Plots and dashboard\nECharts served locally" as dash
}
package "Engine: standard-library analytics" {
 component "BSM pricing\n16 Greeks, IV solver" as pricing
 component "23 registered structures\nsingle and two expiries" as strategies
 component "Exposure, smile\ncomparison and ranking" as analytics
 component "GARCH-t posterior\nindependent predictive paths" as simulation
 component "Historical backtest\nstatistics and paper marking" as backtest
}
database "Local JSON artifacts\nconfigured output directory" as disk
cloud "Separate hosted deployment\n4 hosted skills, remote MCP\nSYNTH sample / permitted uploads\nsee hosted boundary diagram" as hosted
user --> skills : reads rules
user --> mcp
user --> cli
user --> agent
mcp --> cli : shared handlers
agent --> cli : shared handlers
cli --> imp
cli --> reg
cli --> bridge
bridge --> pricing
bridge --> strategies
bridge --> analytics
bridge --> simulation
bridge --> backtest
cli --> valid
cli --> writer
writer --> disk
disk --> dash : read
note bottom of agent
Planning and calculation nodes are deterministic.
An optional model can write the final summary.
end note
note bottom of hosted
The hosted deployment implementation is separate.
This repository supplies its skill and plugin bundles.
Local simulation and backtests require price history.
end note

caption Source: engine_bridge.py, mcp/server.py, strategies/playbook.py, agent graph.py and hosted plugin README.
@enduml
